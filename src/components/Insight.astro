---
const paragraphs = [
  'Con las mismas herramientas no-code, la mayoría de los sitios terminan pareciendo la misma plantilla — colores intercambiables, secciones clonadas, textos que podrían pertenecer a cualquier negocio. El problema no es de mal gusto. Es ausencia de dirección.',
  'Un sitio bien construido no decora un negocio, lo argumenta. Decide qué se dice primero, qué prueba aparece después, y qué acción importa más que las demás — con diseño, código e inteligencia artificial trabajando hacia el mismo objetivo, no por separado.',
];
---

<section class="insight" id="insight" aria-labelledby="insight-heading">
  <div class="insight__inner">
    <div class="insight__content" data-insight-content>
      <p class="insight__eyebrow" data-reveal>El fracaso silencioso</p>

      <h2 class="insight__headline" id="insight-heading" data-reveal>
        La mayoría de los sitios web no fallan. Simplemente pasan desapercibidos.
      </h2>

      <div class="insight__callout" data-reveal>
        <span class="insight__callout-figure">3 segundos</span>
        <span class="insight__callout-caption">
          lo que tarda un visitante en decidir si tu marca merece su atención.
        </span>
      </div>

      {paragraphs.map((paragraph) => (
        <p class="insight__paragraph" data-reveal>{paragraph}</p>
      ))}

      <p class="insight__closing" data-reveal>Esto es lo que hacemos distinto.</p>
    </div>

    <div class="insight__media" data-video-slot aria-hidden="true"></div>
  </div>
</section>

<style>
  .insight {
    position: relative;
    background: var(--color-text);
    color: var(--color-bg);
    padding: clamp(5.5rem, 11vw, 9rem) clamp(1.5rem, 6vw, 4rem);
  }

  .insight__inner {
    max-width: 74rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(3rem, 6vw, 5.5rem);
    align-items: start;
  }

  .insight__content {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .insight__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    overflow: hidden;
    background: rgba(58, 56, 43, 0.06);
  }

  .insight__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .insight__headline {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .insight__callout {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.5rem 0;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(58, 56, 43, 0.16);
    border-bottom: 1px solid rgba(58, 56, 43, 0.16);
  }

  .insight__callout-figure {
    font-size: clamp(2.25rem, 4.6vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .insight__callout-caption {
    max-width: 32ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    opacity: 0.72;
  }

  .insight__paragraph {
    max-width: 58ch;
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.65;
    opacity: 0.85;
  }

  .insight__closing {
    margin: 0.5rem 0 0;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  :global(html.js) [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
  }

  @media (max-width: 860px) {
    .insight__inner {
      grid-template-columns: 1fr;
    }

    .insight__media {
      order: -1;
      aspect-ratio: 4 / 5;
      max-height: 60vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const slot = document.querySelector<HTMLElement>('[data-video-slot]');

  if (items.length && slot) {
    let revealed = false;

    const reveal = () => {
      if (revealed) return;
      revealed = true;

      if (prefersReducedMotion) {
        gsap.set(items, { clearProps: 'opacity,transform' });
      } else {
        gsap.to(items, {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: 'power2.out',
          stagger: 0.08,
        });
      }
    };

    // The hero video docks into this slot partway through the scroll
    // transition (see index.astro) and is still large enough to cover this
    // text for most of that transition. Rather than guess a scroll offset,
    // wait for the video to actually land here — the one moment we know
    // for certain it has cleared out of the way — then reveal the text.
    if (slot.hasChildNodes()) {
      reveal();
    } else {
      const observer = new MutationObserver(() => {
        if (slot.hasChildNodes()) {
          reveal();
          observer.disconnect();
        }
      });
      observer.observe(slot, { childList: true });
    }
  }
</script>
