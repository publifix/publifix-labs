---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  project: {
    name: string;
    category: string;
    description: string;
    image: ImageMetadata;
    fullSrc: string;
    fullWidth: number;
    fullHeight: number;
  };
}

const { project } = Astro.props;
const altText = `${project.name} — proyecto de ${project.category.toLowerCase().replace('ia', 'IA')} desarrollado por Publifix Labs`;
---

<button
  type="button"
  class="work-card"
  data-trabajo-card
  data-name={project.name}
  data-category={project.category}
  data-description={project.description}
  data-full-src={project.fullSrc}
  data-full-width={project.fullWidth}
  data-full-height={project.fullHeight}
>
  <span class="work-card__media">
    <Image src={project.image} alt="" aria-hidden="true" width={640} loading="lazy" class="work-card__bg" />
    <Image src={project.image} alt={altText} width={960} loading="lazy" class="work-card__fg" />
  </span>
  <span class="work-card__meta">{project.category} — {project.name}</span>
  <span class="work-card__explore">Explorar Proyecto →</span>
</button>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: var(--color-bg);
    text-align: left;
    cursor: pointer;
  }

  .work-card__media {
    position: relative;
    display: block;
    flex: 1;
    min-height: 0;
    border-radius: 22px;
    overflow: hidden;
    background: var(--color-bg);
  }

  .work-card__media :global(.work-card__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(30px) brightness(0.75) saturate(1.1);
    transform: scale(1.25);
  }

  .work-card__media :global(.work-card__fg) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .work-card__meta {
    flex-shrink: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .work-card__explore {
    flex-shrink: 0;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    padding: 0.65em 1.4em;
    border-radius: 999px;
    border: 1px solid var(--color-bg);
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color 0.25s var(--ease-premium), color 0.25s var(--ease-premium);
  }

  .work-card:hover .work-card__explore,
  .work-card:focus-visible .work-card__explore {
    background-color: var(--color-bg);
    color: var(--color-text);
  }
</style>
