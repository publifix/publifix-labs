---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  project: {
    name: string;
    category: string;
    description: string;
    image: ImageMetadata;
    fullSrc: string;
  };
}

const { project } = Astro.props;
const altText = `${project.name} — proyecto de ${project.category.toLowerCase().replace('ia', 'IA')} desarrollado por Publifix Labs`;
---

<button
  type="button"
  class="work-card"
  data-trabajo-card
  data-name={project.name}
  data-category={project.category}
  data-description={project.description}
  data-full-src={project.fullSrc}
>
  <span class="work-card__media">
    <Image src={project.image} alt={altText} width={960} loading="lazy" />
  </span>
  <span class="work-card__meta">{project.category} — {project.name}</span>
  <span class="work-card__explore">Explorar Proyecto →</span>
</button>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: var(--color-bg);
    text-align: left;
    cursor: pointer;
  }

  .work-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 22px;
    overflow: hidden;
  }

  .work-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-card__meta {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .work-card__explore {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    padding: 0.65em 1.4em;
    border-radius: 999px;
    border: 1px solid var(--color-bg);
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color 0.25s var(--ease-premium), color 0.25s var(--ease-premium);
  }

  .work-card:hover .work-card__explore,
  .work-card:focus-visible .work-card__explore {
    background-color: var(--color-bg);
    color: var(--color-text);
  }
</style>
