---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  project: {
    name: string;
    category: string;
    description: string;
    image: ImageMetadata;
    fullSrc: string;
  };
}

const { project } = Astro.props;
const altText = `${project.name} — proyecto de ${project.category.toLowerCase().replace('ia', 'IA')} desarrollado por Publifix Labs`;
---

<div class="work-card">
  <div class="work-card__media">
    <Image src={project.image} alt={altText} width={960} loading="lazy" />
  </div>
  <p class="work-card__meta">{project.category} — {project.name}</p>
  <button
    type="button"
    class="work-card__explore"
    data-trabajo-card
    data-name={project.name}
    data-category={project.category}
    data-description={project.description}
    data-full-src={project.fullSrc}
  >
    Explorar Proyecto
  </button>
</div>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 30rem;
  }

  .work-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 22px;
    overflow: hidden;
  }

  .work-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-card__meta {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .work-card__explore {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    padding: 0.65em 1.4em;
    border-radius: 999px;
    border: 1px solid var(--panel-text, currentColor);
    background: none;
    color: var(--panel-text, inherit);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.25s var(--ease-premium), color 0.25s var(--ease-premium);
  }

  .work-card__explore:hover,
  .work-card__explore:focus-visible {
    background-color: var(--panel-text, currentColor);
    color: var(--panel-bg, var(--color-text));
  }
</style>
