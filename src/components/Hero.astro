---
import heroVideoSrc from '../assets/video/hero-background.mp4';

const line1 = 'No construimos sitios web.'.split(' ');
const line2 = 'Construimos ventaja.'.split(' ');
const lines = [line1, line2];
let wordIndex = 0;
---

<section class="hero" id="top" aria-label="Publifix Labs">
  <div class="hero__media">
    <video
      class="hero__video"
      data-hero-video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src={heroVideoSrc} type="video/mp4" />
    </video>
    <div class="hero__overlay" data-hero-overlay></div>
  </div>

  <div class="hero__content">
    <h1 class="hero__headline" data-headline>
      {lines.map((words) => (
        <span class="hero__line">
          {words.map((word) => {
            const delay = wordIndex * 60;
            wordIndex += 1;
            return (
              <span class="hero__word-mask">
                <span class="hero__word" style={`transition-delay: ${delay}ms`}>{word}</span>
              </span>
            );
          })}
        </span>
      ))}
    </h1>

    <a href="#contacto" class="hero__cta" data-magnetic>
      <span class="hero__cta-inner" data-magnetic-inner>Iniciar proyecto</span>
    </a>
  </div>

  <div class="hero__scroll" data-scroll-indicator aria-hidden="true">
    <span class="hero__scroll-track">
      <span class="hero__scroll-dot"></span>
    </span>
    <span class="hero__scroll-label">Scroll</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--color-bg);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__video {
    position: absolute;
    inset: -10% 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
    will-change: transform;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    opacity: 0.42;
    transition: opacity 0.2s linear;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 6vw, 4rem);
    height: 100%;
    padding: clamp(6rem, 10vw, 8rem) clamp(1.5rem, 6vw, 4rem);
    text-align: center;
  }

  .hero__headline {
    margin: 0;
    max-width: 20ch;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2.5rem, 6.4vw, 6rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero__line {
    display: block;
  }

  .hero__word-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero__word-mask:not(:last-child) {
    margin-right: 0.26em;
  }

  .hero__word {
    display: inline-block;
  }

  :global(html.js) .hero__word {
    transform: translateY(115%);
    opacity: 0;
    transition: transform 0.9s var(--ease-premium), opacity 0.7s var(--ease-premium);
  }

  :global(html.js) .hero__headline.is-revealed .hero__word {
    transform: translateY(0);
    opacity: 1;
  }

  .hero__cta {
    position: relative;
    display: inline-flex;
    text-decoration: none;
  }

  .hero__cta-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.1em 2.6em;
    border-radius: 999px;
    border: 1px solid var(--color-text);
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: background-color 0.3s var(--ease-premium), color 0.3s var(--ease-premium),
      transform 0.4s var(--ease-premium);
    will-change: transform;
  }

  .hero__cta:hover .hero__cta-inner,
  .hero__cta:focus-visible .hero__cta-inner {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .hero__cta:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
    border-radius: 999px;
  }

  :global(html.js) .hero__cta {
    opacity: 0;
    transition: opacity 0.6s var(--ease-premium);
  }

  :global(html.js) .hero__content.is-revealed .hero__cta {
    opacity: 1;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.75rem, 4vw, 2.75rem);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    transform: translateX(-50%);
    opacity: 0.85;
    transition: opacity 0.6s var(--ease-premium), visibility 0.6s;
  }

  :global(html.js) .hero__scroll {
    opacity: 0;
  }

  :global(html.js) .hero__scroll.is-visible {
    opacity: 0.85;
  }

  .hero__scroll.is-dimmed {
    opacity: 0;
    visibility: hidden;
  }

  .hero__scroll-track {
    position: relative;
    width: 1px;
    height: 38px;
    background: rgba(255, 252, 233, 0.35);
    overflow: hidden;
  }

  .hero__scroll-dot {
    position: absolute;
    top: 0;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2px;
    border-radius: 999px;
    background: var(--color-text);
    animation: scroll-dot 2s var(--ease-premium) infinite;
  }

  .hero__scroll-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  @keyframes scroll-dot {
    0% {
      transform: translateY(-6px);
      opacity: 0;
    }
    35% {
      opacity: 1;
    }
    100% {
      transform: translateY(38px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word {
      transition-delay: 0ms !important;
    }

    .hero__scroll-dot {
      animation: none;
      top: 16px;
      opacity: 0.6;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const headline = document.querySelector<HTMLElement>('[data-headline]');
  const content = headline?.closest<HTMLElement>('.hero__content');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const overlay = document.querySelector<HTMLElement>('[data-hero-overlay]');
  const scrollIndicator = document.querySelector<HTMLElement>('[data-scroll-indicator]');
  const magneticButton = document.querySelector<HTMLElement>('[data-magnetic]');
  const magneticInner = document.querySelector<HTMLElement>('[data-magnetic-inner]');

  // --- Entrance reveal: split-text headline + CTA fade, staggered on load ---
  const reveal = () => {
    headline?.classList.add('is-revealed');
    content?.classList.add('is-revealed');
    scrollIndicator?.classList.add('is-visible');
  };

  if (prefersReducedMotion) {
    reveal();
  } else {
    let revealed = false;
    const revealOnce = () => {
      if (revealed) return;
      revealed = true;
      reveal();
    };

    const fallback = window.setTimeout(revealOnce, 1600);

    Promise.resolve(document.fonts?.ready ?? Promise.resolve()).then(() => {
      window.clearTimeout(fallback);
      window.requestAnimationFrame(() => window.requestAnimationFrame(revealOnce));
    });
  }

  // --- Scroll-tied effects: parallax on video, overlay intensify, scroll indicator fade ---
  if (!prefersReducedMotion && (video || overlay || scrollIndicator)) {
    const heroSection = document.querySelector<HTMLElement>('.hero');
    let ticking = false;

    const update = () => {
      ticking = false;
      const heroHeight = heroSection?.offsetHeight ?? window.innerHeight;
      const scrollY = Math.min(window.scrollY, heroHeight);
      const progress = Math.min(scrollY / (heroHeight * 0.6), 1);

      if (video) {
        video.style.transform = `translateY(${scrollY * 0.12}px)`;
      }

      if (overlay) {
        overlay.style.opacity = String(0.42 + progress * 0.22);
      }

      if (scrollIndicator) {
        scrollIndicator.classList.toggle('is-dimmed', window.scrollY > 60);
      }
    };

    update();

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
  }

  // --- Magnetic micro-interaction on the primary CTA ---
  if (!prefersReducedMotion && magneticButton && magneticInner) {
    const strength = 0.35;
    const maxOffset = 14;

    const clamp = (value: number, limit: number) => Math.max(-limit, Math.min(limit, value));

    magneticButton.addEventListener('mousemove', (event) => {
      const rect = magneticButton.getBoundingClientRect();
      const x = event.clientX - rect.left - rect.width / 2;
      const y = event.clientY - rect.top - rect.height / 2;

      magneticInner.style.transform = `translate(${clamp(x * strength, maxOffset)}px, ${clamp(y * strength, maxOffset)}px)`;
    });

    magneticButton.addEventListener('mouseleave', () => {
      magneticInner.style.transform = 'translate(0, 0)';
    });
  }

  // --- Video autoplay resilience: some mobile browsers block autoplay even when muted ---
  video?.play().catch(() => {
    /* Autoplay was blocked; the poster/first frame remains visible. */
  });
</script>
